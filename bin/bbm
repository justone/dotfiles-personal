#!/bin/sh

#_(
  "exec" "bb" "-I" "-O" "--stream" "$0" "$@"
  )

(if-some [transform-str (first *command-line-args*)]
  (binding [*print-meta* true]
    (let [transform (eval (read-string transform-str))]
      (prn (transform user/*input*))))
  (println "usage: bbm [predicate]"))

